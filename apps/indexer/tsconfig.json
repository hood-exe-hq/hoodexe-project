{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "envio-env.d.ts"],
  // Typed by codegen for config.verification.yaml, not config.yaml (envio generates one config's types at a time);
  // its tests run against that config (scripts/envio.mjs test).
  "exclude": ["src/verification"]
}
