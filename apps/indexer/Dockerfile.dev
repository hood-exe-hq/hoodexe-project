# Local runtime for the Envio indexer. envio ships no Windows binary, so on Windows hosts the CLI runs
# here (Linux). Dependencies live in the image; compose mounts the source over /app and keeps this
# node_modules with an anonymous volume, so host and container installs never mix.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json ./
# npm 10 (bundled with node 22) fails on envio's dependency tree ("reading 'edgesOut'"); npm 11 installs it.
RUN npx -y npm@11.21.0 install --no-package-lock --no-audit --no-fund
